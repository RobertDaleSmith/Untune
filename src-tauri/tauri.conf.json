{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Untune",
  "mainBinaryName": "Untune",
  "version": "0.1.0",
  "identifier": "com.untune.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Untune",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["untune"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "scripts/*": "scripts/",
      "bin/*": "bin/",
      "icons/icon-light.png": "icons/icon-light.png",
      "icons/icon-dark.png": "icons/icon-dark.png"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": null,
      "minimumSystemVersion": "13.0"
    }
  }
}
